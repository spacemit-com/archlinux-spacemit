 src/egl/drivers/dri2/platform_x11.c         |  8 ++++++
 src/egl/drivers/dri2/platform_x11_dri3.c    |  7 ++++++
 src/egl/main/egldevice.c                    | 26 +++++++++++++++++++
 src/egl/main/eglglvnd.c                     | 28 +++++++++++++++++++++
 10 files changed, 132 insertions(+)

diff --git a/src/egl/drivers/dri2/egl_dri2.c b/src/egl/drivers/dri2/egl_dri2.c
index 2de12bc5..5802ab89 100644
--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -1317,6 +1317,32 @@ dri2_setup_device(_EGLDisplay *disp, EGLBoolean software)
  * This must be guaranteed to be called exactly once, even if eglInitialize is
  * called many times (without a eglTerminate in between).
  */
+/**
+ * PVR vendor driver name filter for GLVND multi-vendor coexistence.
+ * Only claim devices whose DRM driver matches the PVR/Imagination GPU.
+ * If this vendor library does not support the device, return false so
+ * the GLVND loader can fall back to the next vendor (e.g. system mesa).
+ */
+bool
+dri2_pvr_is_supported_driver(const char *driver_name)
+{
+   static const char *pvr_drivers[] = {
+      "pvr",
+      "powervr",
+      "spacemit",   /* gallium-pvr-alias */
+   };
+
+   if (!driver_name)
+      return false;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(pvr_drivers); i++) {
+      if (strcmp(driver_name, pvr_drivers[i]) == 0)
+         return true;
+   }
+   _eglLog(_EGL_DEBUG, "dri2_pvr_is_supported_driver: failed with driver name '%s'", driver_name);
+   return false;
+}
+
 static EGLBoolean
 dri2_initialize(_EGLDisplay *disp)
 {
diff --git a/src/egl/drivers/dri2/egl_dri2.h b/src/egl/drivers/dri2/egl_dri2.h
index b63bdd6a..744c8523 100644
--- a/src/egl/drivers/dri2/egl_dri2.h
+++ b/src/egl/drivers/dri2/egl_dri2.h
@@ -710,6 +710,13 @@ dri2_initialize_android(_EGLDisplay *disp)
 EGLBoolean
 dri2_initialize_surfaceless(_EGLDisplay *disp);

+/**
+ * PVR vendor driver name filter for GLVND multi-vendor coexistence.
+ * Returns true if the driver_name is claimed by this PVR vendor library.
+ */
+bool
+dri2_pvr_is_supported_driver(const char *driver_name);
+
 #ifdef HAVE_NULL_PLATFORM
 EGLBoolean
 dri2_initialize_null(_EGLDisplay *disp);
diff --git a/src/egl/drivers/dri2/platform_device.c b/src/egl/drivers/dri2/platform_device.c
index 3b5daafd..18e29532 100644
--- a/src/egl/drivers/dri2/platform_device.c
+++ b/src/egl/drivers/dri2/platform_device.c
@@ -287,6 +287,12 @@ device_probe_device(_EGLDisplay *disp)
    if (!dri2_dpy->driver_name)
       goto err_name;

+   if (!dri2_pvr_is_supported_driver(dri2_dpy->driver_name)) {
+      _eglLog(_EGL_DEBUG, "PVR EGL: skipping unsupported device (driver: %s)",
+              dri2_dpy->driver_name);
+      goto err_load;
+   }
+
    /* When doing software rendering, some times user still want to explicitly
     * choose the render node device since cross node import doesn't work between
     * vgem/virtio_gpu yet. It would be nice to have a new EXTENSION for this.
diff --git a/src/egl/drivers/dri2/platform_drm.c b/src/egl/drivers/dri2/platform_drm.c
index 38fe1bd0..4339e0a6 100644
--- a/src/egl/drivers/dri2/platform_drm.c
+++ b/src/egl/drivers/dri2/platform_drm.c
@@ -739,6 +739,14 @@ dri2_initialize_drm(_EGLDisplay *disp)

    dri2_dpy->driver_name = strdup(dri2_dpy->gbm_dri->driver_name);

+   /* PVR vendor filter: only claim devices we support */
+   if (!dri2_pvr_is_supported_driver(dri2_dpy->driver_name)) {
+      _eglLog(_EGL_DEBUG, "PVR vendor: skipping unsupported driver '%s'",
+              dri2_dpy->driver_name);
+      err = "PVR: unsupported DRM device";
+      goto cleanup;
+   }
+
    if (!dri2_load_driver_dri3(disp)) {
       err = "DRI3: failed to load driver";
       goto cleanup;
diff --git a/src/egl/drivers/dri2/platform_surfaceless.c b/src/egl/drivers/dri2/platform_surfaceless.c
index 8141a110..40f01099 100644
--- a/src/egl/drivers/dri2/platform_surfaceless.c
+++ b/src/egl/drivers/dri2/platform_surfaceless.c
@@ -259,6 +259,15 @@ surfaceless_probe_device(_EGLDisplay *disp, bool swrast, bool zink)
             dri2_dpy->driver_name = strdup("kms_swrast");
          free(driver_name);
       } else {
+         /* PVR vendor filter: only claim devices we support */
+         if (!dri2_pvr_is_supported_driver(driver_name)) {
+            _eglLog(_EGL_DEBUG, "PVR vendor: skipping unsupported driver '%s'",
+                    driver_name ? driver_name : "(null)");
+            free(driver_name);
+            close(dri2_dpy->fd_render_gpu);
+            dri2_dpy->fd_render_gpu = -1;
+            goto next;
+         }
          /* Use the given hardware driver */
          dri2_dpy->driver_name = driver_name;
       }
diff --git a/src/egl/drivers/dri2/platform_wayland.c b/src/egl/drivers/dri2/platform_wayland.c
index f1fb5b36..6ae45bda 100644
--- a/src/egl/drivers/dri2/platform_wayland.c
+++ b/src/egl/drivers/dri2/platform_wayland.c
@@ -2493,6 +2493,13 @@ dri2_initialize_wayland_drm(_EGLDisplay *disp)
       goto cleanup;
    }

+   /* PVR vendor filter: only claim devices we support */
+   if (!dri2_pvr_is_supported_driver(dri2_dpy->driver_name)) {
+      _eglLog(_EGL_DEBUG, "PVR vendor: skipping unsupported driver '%s'",
+              dri2_dpy->driver_name);
+      goto cleanup;
+   }
+
    dri2_dpy->loader_extensions = dri2_loader_extensions;
    if (!dri2_load_driver_dri3(disp)) {
       _eglError(EGL_BAD_ALLOC, "DRI2: failed to load driver");
diff --git a/src/egl/drivers/dri2/platform_x11.c b/src/egl/drivers/dri2/platform_x11.c
index 1b77adea..2cfa336b 100644
--- a/src/egl/drivers/dri2/platform_x11.c
+++ b/src/egl/drivers/dri2/platform_x11.c
@@ -750,6 +750,14 @@ dri2_x11_connect(struct dri2_egl_display *dri2_dpy)
       return EGL_FALSE;
    }

+   /* PVR vendor filter: only claim devices we support */
+   if (!dri2_pvr_is_supported_driver(dri2_dpy->driver_name)) {
+      _eglLog(_EGL_DEBUG, "PVR vendor: skipping unsupported driver '%s'",
+              dri2_dpy->driver_name);
+      free(connect);
+      return EGL_FALSE;
+   }
+
 #ifdef HAVE_WAYLAND_PLATFORM
    dri2_dpy->device_name =
       strndup(device_name, xcb_dri2_connect_device_name_length(connect));
diff --git a/src/egl/drivers/dri2/platform_x11_dri3.c b/src/egl/drivers/dri2/platform_x11_dri3.c
index 486f7aac..526a0a1d 100644
--- a/src/egl/drivers/dri2/platform_x11_dri3.c
+++ b/src/egl/drivers/dri2/platform_x11_dri3.c
@@ -651,6 +651,13 @@ dri3_x11_connect(struct dri2_egl_display *dri2_dpy)
       return EGL_FALSE;
    }

+   /* PVR vendor filter: only claim devices we support */
+   if (!dri2_pvr_is_supported_driver(dri2_dpy->driver_name)) {
+      _eglLog(_EGL_DEBUG, "PVR vendor: skipping unsupported driver '%s'",
+              dri2_dpy->driver_name);
+      return EGL_FALSE;
+   }
+
 #ifdef HAVE_WAYLAND_PLATFORM
    /* Only try to get a render device name since dri3 doesn't provide a
     * mechanism for authenticating client opened device node fds. If this
diff --git a/src/egl/main/egldevice.c b/src/egl/main/egldevice.c
index daa2aa0a..bb798860 100644
--- a/src/egl/main/egldevice.c
+++ b/src/egl/main/egldevice.c
@@ -27,6 +27,8 @@

 #ifdef HAVE_LIBDRM
 #include <xf86drm.h>
+#include <fcntl.h>
+#include <unistd.h>
 #endif
 #include "util/compiler.h"
 #include "util/macros.h"
@@ -37,6 +39,13 @@
 #include "egllog.h"
 #include "egltypedefs.h"

+#ifdef HAVE_LIBDRM
+#include "loader/loader.h"
+
+/* Declared in drivers/dri2/egl_dri2.c */
+extern bool dri2_pvr_is_supported_driver(const char *driver_name);
+#endif
+
 struct _egl_device {
    _EGLDevice *Next;

@@ -322,6 +331,23 @@ _eglDeviceRefreshList(void)
          continue;
       }

+      /* PVR vendor filter: only enumerate devices we can actually drive.
+       * This prevents GLVND from binding unsupported devices to our vendor. */
+      const char *render_node = devices[i]->nodes[DRM_NODE_RENDER];
+      int fd = open(render_node, O_RDWR | O_CLOEXEC);
+      if (fd >= 0) {
+         char *driver = loader_get_driver_for_fd(fd);
+         close(fd);
+         if (driver) {
+            bool supported = dri2_pvr_is_supported_driver(driver);
+            free(driver);
+            if (!supported) {
+               drmFreeDevice(&devices[i]);
+               continue;
+            }
+         }
+      }
+
       ret = _eglAddDRMDevice(devices[i]);

       /* Device is not added - error or already present */
diff --git a/src/egl/main/eglglvnd.c b/src/egl/main/eglglvnd.c
index b9bec229..08920201 100644
--- a/src/egl/main/eglglvnd.c
+++ b/src/egl/main/eglglvnd.c
@@ -34,6 +34,14 @@
 #include "egldispatchstubs.h"
 #include "eglglobals.h"

+#ifdef HAVE_DRM_PLATFORM
+#include <gbm.h>
+#include "loader/loader.h"
+
+/* Declared in egl_dri2.h / egl_dri2.c */
+extern bool dri2_pvr_is_supported_driver(const char *driver_name);
+#endif
+
 static const __EGLapiExports *__eglGLVNDApiExports = NULL;

 static const char *EGLAPIENTRY
@@ -61,6 +69,26 @@ static EGLDisplay
 __eglGLVNDGetPlatformDisplay(EGLenum platform, void *native_display,
                              const EGLAttrib *attrib_list)
 {
+#ifdef HAVE_DRM_PLATFORM
+   /* PVR vendor early rejection: if the GBM device is backed by a DRM driver
+    * we don't support, return EGL_NO_DISPLAY so GLVND can try the next vendor.
+    * Without this, we'd claim the display here and then fail later in
+    * eglInitialize, at which point GLVND won't fallback to another vendor. */
+   if (platform == EGL_PLATFORM_GBM_MESA && native_display != NULL) {
+      struct gbm_device *gbm = (struct gbm_device *)native_display;
+      int fd = gbm_device_get_fd(gbm);
+      if (fd >= 0) {
+         char *driver = loader_get_driver_for_fd(fd);
+         if (driver) {
+            bool supported = dri2_pvr_is_supported_driver(driver);
+            free(driver);
+            if (!supported)
+               return EGL_NO_DISPLAY;
+         }
+      }
+   }
+#endif
+
    if (platform == EGL_NONE) {
       assert(native_display == (void *)EGL_DEFAULT_DISPLAY);
       assert(attrib_list == NULL);
